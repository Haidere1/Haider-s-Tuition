# Copy to .env for local use. On your host (Render etc.) set these as environment variables instead.
# Paste your MongoDB Atlas connection string here (after you rotate the password):
MONGODB_URI=
# Any long random string, e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Your teacher password
ADMIN_PASSWORD=
# Your GitHub Pages URL, no trailing slash. Comma-separate for more than one.
CLIENT_ORIGIN=https://YOUR-USERNAME.github.io
